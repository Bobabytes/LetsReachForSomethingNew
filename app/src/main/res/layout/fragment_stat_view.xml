<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Input Section -->
        <LinearLayout
            android:id="@+id/containerInputs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:hint="Enter your name"
                android:inputType="textPersonName"
                android:textColor="@color/secondaryColor"
                android:textColorHint="@color/secondaryColor" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="Pronouns" />

            <Spinner
                android:id="@+id/spPronouns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/pronouns_array" />

            <RatingBar
                android:id="@+id/rbReviewScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:numStars="6"
                android:stepSize="0.5" />

            <EditText
                android:id="@+id/etReviewComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:hint="Write a review comment"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColorHint="@color/secondaryColor" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Do you want to receive updates?" />

            <Spinner
                android:id="@+id/spReceiveUpdates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/updates_array" />

            <Switch
                android:id="@+id/switchWatchedFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Watched the show Friends?"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Submit &amp; See Stats!" />
        </LinearLayout>


        <!-- Information Display Section -->
        <LinearLayout
            android:id="@+id/containerSubmittedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSubmittedInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submitted Information"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvPronouns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvReviewScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvReviewComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvReceiveUpdates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvWatchedFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvAppTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:text="You've had the app open for 0 seconds!" />

            <Button
                android:id="@+id/btnEditReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Edit Review" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
